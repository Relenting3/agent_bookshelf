+export interface TopRatedBook extends Book {
+  average_rating: number;
+  review_count: number;
+}
+
+export function getTopRatedBooks(limit = 10): TopRatedBook[] {
+  return all(`
+    SELECT b.*, AVG(r.rating) AS average_rating, COUNT(r.id) AS review_count
+    FROM books b
+    JOIN reviews r ON r.book_id = b.id
+    GROUP BY b.id
+    ORDER BY average_rating DESC, review_count DESC, b.title ASC
+    LIMIT ?
+  `, [limit]) as unknown as TopRatedBook[];
+}
+
